generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
  WORKER
}

enum Status {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  password           String
  role               Role
  roomNo             String?
  phone              String?
  createdAt          DateTime             @default(now())

  complaints         Complaint[]          @relation("StudentComplaints")
  assignedComplaints Complaint[]          @relation("WorkerComplaints")
  statusChanges      ComplaintStatusLog[]
}

model Complaint {
  id          Int      @id @default(autoincrement())
  student     User     @relation("StudentComplaints", fields: [studentId], references: [id])
  studentId   Int
  category    String
  title       String
  description String   @db.Text
  photoUrl    String?
  status      Status   @default(PENDING)
  worker      User?    @relation("WorkerComplaints", fields: [workerId], references: [id])
  workerId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        ComplaintStatusLog[]
}

model ComplaintStatusLog {
  id          Int       @id @default(autoincrement())
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  complaintId Int
  status      Status
  changedBy   User      @relation(fields: [changedById], references: [id])
  changedById Int
  changedAt   DateTime  @default(now())
}